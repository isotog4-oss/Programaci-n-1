void reportarVentasPorMesMatriz() {
    // Matriz de acumulación: 12 meses, 31 días por mes
    double ventasPorMes[12][31];
    
    // Inicialización explícita de la matriz a 0.0
    for(int i = 0; i < 12; i++) {
        for(int j = 0; j < 31; j++) {
            ventasPorMes[i][j] = 0.0;
        }
    }

    std::ifstream archivo("ventas.dat", std::ios::binary);
    if (!archivo) {
        std::cout << "No hay datos de ventas procesadas.\n";
        return;
    }

    Venta v;
    while (archivo.read(reinterpret_cast<char*>(&v), sizeof(Venta))) {
        if (v.mes >= 1 && v.mes <= 12 && v.dia >= 1 && v.dia <= 31) {
            ventasPorMes[v.mes - 1][v.dia - 1] += v.total;
        }
    }
    archivo.close();

    std::cout << "\n--- RESUMEN CONSOLIDADO ANUAL DE VENTAS POR MES ---\n";
    const char* meses[] = {"Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"};
    
    for (int i = 0; i < 12; i++) {
        double totalMes = 0;
        for (int j = 0; j < 31; j++) {
            totalMes += ventasPorMes[i][j];
        }
        std::cout << "Mes de " << meses[i] << ": \tQ" << totalMes << "\n";
    }
}

// Algoritmos de Ordenamiento Obligatorios (Bubble Sort & Selection Sort)
void ordenarProductos(int criterio, bool ascendente) {
    std::ifstream archivoIn("productos.dat", std::ios::binary);
    if (!archivoIn) return;

    // Cargar en memoria temporal para poder ordenar
    Producto lista[500];
    int n = 0;

    while (archivoIn.read(reinterpret_cast<char*>(&lista[n]), sizeof(Producto))) {
        if (lista[n].activo) n++;
    }
    archivoIn.close();

    // Algoritmo 1: Bubble Sort (Ordenamiento por Precio)
    if (criterio == 1) {
        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                bool condicion = ascendente ? (lista[j].precio > lista[j+1].precio) : (lista[j].precio < lista[j+1].precio);
                if (condicion) {
                    Producto temp = lista[j];
                    lista[j] = lista[j+1];
                    lista[j+1] = temp;
                }
            }
        }
    } 
    // Algoritmo 2: Selection Sort (Ordenamiento por Stock)
    else if (criterio == 2) {
        for (int i = 0; i < n - 1; i++) {
            int indiceDestacado = i;
            for (int j = i + 1; j < n; j++) {
                bool condicion = ascendente ? (lista[j].stock < lista[indiceDestacado].stock) : (lista[j].stock > lista[indiceDestacado].stock);
                if (condicion) indiceDestacado = j;
            }
            Producto temp = lista[i];
            lista[i] = lista[indiceDestacado];
            lista[indiceDestacado] = temp;
        }
    }

    std::cout << "\n--- CATÁLOGO ORDENADO ---\n";
    for (int i = 0; i < n; i++) {
        std::cout << "Código: " << lista[i].codigo << " | " << lista[i].nombre << " | Precio: Q" << lista[i].precio << " | Stock: " << lista[i].stock << "\n";
    }
}

void menuOrdenamiento() {
    std::cout << "\nCriterios de Ordenamiento:\n";
    std::cout << "1. Por Precio Ascendente\n2. Por Precio Descendente\n3. Por Stock Ascendente\n4. Por Stock Descendente\n";
    int op = leerEntero("Seleccione opción: ");
    switch(op) {
        case 1: ordenarProductos(1, true); break;
        case 2: ordenarProductos(1, false); break;
        case 3: ordenarProductos(2, true); break;
        case 4: ordenarProductos(2, false); break;
        default: std::cout << "Opción inválida.\n";
    }
}

