void actualizarStock() {
    std::fstream archivo("productos.dat", std::ios::in | std::ios::out | std::ios::binary);
    try {
        if (!archivo) throw std::runtime_error("Error al abrir el archivo de inventario.");

        int cod = leerEntero("Ingrese el código del producto a actualizar stock: ");
        Producto p;
        long pos = 0;
        bool encontrado = false;

        while (archivo.read(reinterpret_cast<char*>(&p), sizeof(Producto))) {
            if (p.codigo == cod && p.activo) {
                int nuevoStock = leerEntero("Ingrese la cantidad a añadir (positivo) o restar (negativo): ");
                if (p.stock + nuevoStock < 0) throw std::invalid_argument("El stock resultante no puede ser menor a 0.");
                
                p.stock += nuevoStock;
                encontrado = true;

                archivo.seekp(pos);
                archivo.write(reinterpret_cast<const char*>(&p), sizeof(Producto));
                std::cout << "Stock modificado con éxito. Nuevo stock: " << p.stock << "\n";
                break;
            }
            pos = archivo.tellg();
        }
        if (!encontrado) std::cout << "Producto no encontrado.\n";
        archivo.close();
    } catch (const std::exception& e) {
        std::cout << "[Error de Inventario]: " << e.what() << "\n";
        if (archivo.is_open()) archivo.close();
    }
}

