int leerEntero(const char* mensaje) {
    int valor;
    while (true) {
        try {
            std::cout << mensaje;
            if (!(std::cin >> valor)) {
                throw std::invalid_argument("Entrada inválida. Debe ingresar un número entero.");
            }
            return valor;
        } catch (const std::exception& e) {
            std::cout << "[Error]: " << e.what() << "\n";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        }
    }
}

double leerDouble(const char* mensaje) {
    double valor;
    while (true) {
        try {
            std::cout << mensaje;
            if (!(std::cin >> valor)) {
                throw std::invalid_argument("Entrada inválida. Debe ingresar un número decimal.");
            }
            if (valor < 0) {
                throw std::out_of_range("El valor económico no puede ser negativo.");
            }
            return valor;
        } catch (const std::exception& e) {
            std::cout << "[Error]: " << e.what() << "\n";
            std::cin.clear();
            std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
        }
    }
}

void leerCadena(const char* mensaje, char* destino, int tamano) {
    std::cout << mensaje;
    std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    std::cin.getline(destino, tamano);
}

void registrarProducto() {
    std::ofstream archivo("productos.dat", std::ios::binary | std::ios::app);
    try {
        if (!archivo) throw std::runtime_error("No se pudo abrir el archivo de productos.");

        Producto p;
        p.codigo = leerEntero("Ingrese código único del producto: ");
        
        
        std::ifstream verif("productos.dat", std::ios::binary);
        if (verif) {
            Producto temp;
            while (verif.read(reinterpret_cast<char*>(&temp), sizeof(Producto))) {
                if (temp.codigo == p.codigo && temp.activo) {
                    verif.close();
                    throw std::invalid_argument("El código de producto ya existe.");
                }
            }
            verif.close();
        }

        leerCadena("Ingrese nombre del producto: ", p.nombre, MAX_NOM);
        p.precio = leerDouble("Ingrese precio (Q): ");
        p.stock = leerEntero("Ingrese stock inicial: ");
        if (p.stock < 0) throw std::invalid_argument("El stock no puede ser negativo.");
        
        p.ventasAcumuladas = 0;
        p.activo = true;

        archivo.write(reinterpret_cast<const char*>(&p), sizeof(Producto));
        archivo.close();
        std::cout << "¡Producto registrado exitosamente!\n";
    } catch (const std::exception& e) {
        std::cout << "[Error al registrar]: " << e.what() << "\n";
        if (archivo.is_open()) archivo.close();
    }
}

