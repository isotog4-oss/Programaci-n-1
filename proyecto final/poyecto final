void calcularTotalesVenta(Venta &venta) {
    venta.subtotalGeneral = 0;
    int totalArticulos = 0;

    for (int i = 0; i < venta.cantidadDetalles; i++) {
        venta.subtotalGeneral += venta.detalles[i].subtotal;
        totalArticulos += venta.detalles[i].cantidad;
    }

    double porcentajeDescuento = 0.0;
    
    // Regla 1: Subtotal mayor a Q500 -> 5%
    if (venta.subtotalGeneral > 500.0) {
        porcentajeDescuento += 0.05;
    }
    
    // Regla 2: Cantidad total de artículos múltiplo de 5 -> 3% adicional
    if (totalArticulos > 0 && totalArticulos % 5 == 0) {
        porcentajeDescuento += 0.03; 
    }

    venta.descuento = venta.subtotalGeneral * porcentajeDescuento;
    double subtotalConDescuento = venta.subtotalGeneral - venta.descuento;

    // Aplicación del 12% de IVA sobre la base con descuento
    venta.iva = subtotalConDescuento * IVA_GUATEMALA;
    
    // Redondeo obligatorio a 2 decimales usando std::round
    venta.total = std::round((subtotalConDescuento + venta.iva) * 100.0) / 100.0;
}

void realizarDescuentoPorStock(int codigoBuscado, int cantidadVendida) {
    std::fstream archivo("productos.dat", std::ios::in | std::ios::out | std::ios::binary);
    if (!archivo) return;

    Producto p;
    long pos = 0;
    while (archivo.read(reinterpret_cast<char*>(&p), sizeof(Producto))) {
        if (p.codigo == codigoBuscado) {
            p.stock -= cantidadVendida;
            p.ventasAcumuladas += cantidadVendida;
            archivo.seekp(pos);
            archivo.write(reinterpret_cast<const char*>(&p), sizeof(Producto));
            break;
        }
        pos = archivo.tellg();
    }
    archivo.close();
}

void crearVenta() {
    Venta v;
    v.cantidadDetalles = 0;
    
    std::cout << "\n--- APERTURA DE NUEVA VENTA ---\n";
    v.idVenta = leerEntero("Ingrese ID o Número de Factura: ");
    v.dia = leerEntero("Día actual (1-31): ");
    v.mes = leerEntero("Mes actual (1-12): ");
    v.anio = leerEntero("Año actual (AAAA): ");

    char continuar = 's';
    try {
        while (continuar == 's' || continuar == 'S') {
            if (v.cantidadDetalles >= MAX_DETALLES) {
                std::cout << "Se alcanzó el límite máximo de artículos por venta.\n";
                break;
            }

            int cod = leerEntero("Código del producto a vender: ");
            
            // Buscar producto y validar stock
            std::ifstream archivoProd("productos.dat", std::ios::binary);
            if (!archivoProd) throw std::runtime_error("Catálogo de productos no disponible.");

            Producto p;
            bool encontrado = false;
            while (archivoProd.read(reinterpret_cast<char*>(&p), sizeof(Producto))) {
                if (p.codigo == cod && p.activo) {
                    encontrado = true;
                    int cant = leerEntero("Cantidad a llevar: ");
                    if (cant <= 0) throw std::invalid_argument("La cantidad debe ser mayor a cero.");
                    if (p.stock < cant) throw std::invalid_argument("Stock insuficiente en inventario.");

                    // Registrar en el detalle
                    v.detalles[v.cantidadDetalles].codigoProducto = p.codigo;
                    v.detalles[v.cantidadDetalles].cantidad = cant;
                    v.detalles[v.cantidadDetalles].precioUnitario = p.precio;
                    v.detalles[v.cantidadDetalles].subtotal = p.precio * cant;
                    v.cantidadDetalles++;
                    
                    std::cout << "-> " << p.nombre << " añadido a la lista.\n";
                    break;
                }
            }
            archivoProd.close();

            if (!encontrado) std::cout << "El código ingresado no pertenece a un producto activo.\n";

            std::cout << "¿Desea agregar otro producto a esta venta? (s/n): ";
            std::cin >> continuar;
        }

        if (v.cantidadDetalles > 0) {
            calcularTotalesVenta(v);
            
            // Guardar venta de forma persistente
            std::ofstream archivoVentas("ventas.dat", std::ios::binary | std::ios::app);
            if (!archivoVentas) throw std::runtime_error("No se pudo registrar la venta en disco.");
            archivoVentas.write(reinterpret_cast<const char*>(&v), sizeof(Venta));
            archivoVentas.close();

            // Descontar inventario físico
            for (int i = 0; i < v.cantidadDetalles; i++) {
                realizarDescuentoPorStock(v.detalles[i].codigoProducto, v.detalles[i].cantidad);
            }

            std::cout << "\n======================================\n";
            std::cout << "          FACTURA GENERADA            \n";
            std::cout << "======================================\n";
            std::cout << "Subtotal General: Q" << v.subtotalGeneral << "\n";
            std::cout << "Descuento Aplicado: Q" << v.descuento << "\n";
            std::cout << "IVA (12%): Q" << v.iva << "\n";
            std::cout << "TOTAL A PAGAR: Q" << v.total << "\n";
            std::cout << "======================================\n";
        } else {
            std::cout << "Venta cancelada. No se agregaron artículos.\n";
        }

    } catch (const std::exception& e) {
        std::cout << "\n[Error en Transacción]: " << e.what() << " Venta abortada.\n";
    }
}

