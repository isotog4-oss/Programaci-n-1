void reiniciarInventario() {
    std::cout << "⚠️ ¿Está completamente seguro de borrar TODO el inventario y ventas? (s/n): ";
    char conf;
    std::cin >> conf;
    if (conf == 's' || conf == 'S') {
        std::ofstream p("productos.dat", std::ios::trunc);
        std::ofstream v("ventas.dat", std::ios::trunc);
        p.close(); v.close();
        std::cout << "El sistema ha sido inicializado de fábrica.\n";
    } else {
        std::cout << "Operación cancelada.\n";
    }
}

void mostrarEstadisticasGenerales() {
    std::ifstream archivo("productos.dat", std::ios::binary);
    if (!archivo) return;

    Producto p;
    int totalItems = 0;
    double capitalInvertido = 0;
    while (archivo.read(reinterpret_cast<char*>(&p), sizeof(Producto))) {
        if (p.activo) {
            totalItems += p.stock;
            capitalInvertido += (p.stock * p.precio);
        }
    }
    archivo.close();

    std::cout << "\n--- ESTADÍSTICAS DEL NEGOCIO ---\n";
    std::cout << "Unidades físicas en bodega: " << totalItems << " unidades.\n";
    std::cout << "Valor total de inventario: Q" << capitalInvertido << "\n";
}

